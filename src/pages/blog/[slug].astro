---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);

const categoryColors: Record<string, string> = {
  Tutorial: 'badge-cyan',
  Opinion: 'badge-violet',
  'Case Study': 'badge-green',
  Dev: 'badge-surface',
  'Open Source': 'badge-surface',
};

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <!-- Reading progress bar -->
  <div class="reading-progress" id="reading-progress" role="progressbar" aria-label="Reading progress" aria-valuemin={0} aria-valuemax={100}></div>

  <Navbar />

  <main style="padding-top: var(--nav-height);">
    <div class="container">
      <!-- Back link -->
      <div style="padding-top:var(--space-10);margin-bottom:var(--space-8);">
        <a href="/blog" class="btn btn-ghost" style="display:inline-flex;align-items:center;gap:var(--space-2);">
          ← Back to Blog
        </a>
      </div>

      <!-- Post Header -->
      <header style="max-width:860px;margin:0 auto var(--space-10);">
        <div style="display:flex;gap:var(--space-2);flex-wrap:wrap;margin-bottom:var(--space-5);">
          <span class={`badge ${categoryColors[post.data.category] || 'badge-surface'}`}>
            {post.data.category}
          </span>
          {post.data.tags.map(tag => (
            <a href={`/blog/tag/${encodeURIComponent(tag.toLowerCase())}`} class="badge badge-surface" style="text-decoration:none;">
              #{tag}
            </a>
          ))}
        </div>

        <h1 class="font-display" style="font-size:clamp(2rem,5vw,3rem);font-weight:800;letter-spacing:-0.02em;line-height:var(--leading-tight);margin-bottom:var(--space-5);">
          {post.data.title}
        </h1>

        <p class="text-secondary" style="font-size:var(--text-lg);line-height:var(--leading-relaxed);margin-bottom:var(--space-6);">
          {post.data.description}
        </p>

        <!-- Meta row -->
        <div style="display:flex;align-items:center;gap:var(--space-4);font-size:var(--text-sm);color:var(--color-text-muted);flex-wrap:wrap;padding-bottom:var(--space-6);border-bottom:1px solid var(--color-border);">
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          <span>·</span>
          <span>{post.data.readingTime ?? 5} min read</span>
          {post.data.updatedDate && (
            <>
              <span>·</span>
              <span>Updated {post.data.updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </>
          )}
        </div>
      </header>

      <!-- Cover Image -->
      <div style="width:100%;height:380px;background:linear-gradient(135deg,#0d1a2e,#1a2e4a,#0d2a3a);border-radius:var(--radius-xl);border:1px solid var(--color-border);display:flex;align-items:center;justify-content:center;font-size:5rem;margin-bottom:var(--space-12);">
        ☁️
      </div>

      <!-- Post Body & TOC Layout -->
      <div class="article-layout" style="display:grid;grid-template-columns:minmax(0, 1fr) 260px;gap:var(--space-10);align-items:start;max-width:1100px;margin:0 auto;">
        
        <!-- Main Article Content -->
        <div style="min-width:0;">
          <article class="prose" id="article-body">
            <Content />
          </article>

          <!-- Share row -->
          <div style="margin-top:var(--space-10);padding-top:var(--space-8);border-top:1px solid var(--color-border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-4);">
            <div>
              <p class="text-sm text-muted" style="margin-bottom:var(--space-2);">Share this article</p>
              <div style="display:flex;gap:var(--space-2);">
                <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.toString())}`}
                   target="_blank" rel="noopener" class="btn btn-ghost" style="font-size:var(--text-xs);" id="share-twitter">
                  Twitter/X ↗
                </a>
                <button
                  id="copy-link-btn"
                  class="btn btn-ghost"
                  style="font-size:var(--text-xs);"
                  type="button"
                >
                  Copy Link
                </button>
              </div>
            </div>
            <div style="display:flex;gap:var(--space-2);flex-wrap:wrap;">
              {post.data.tags.map(tag => (
                <a href={`/blog/tag/${encodeURIComponent(tag.toLowerCase())}`} class="badge badge-surface" style="text-decoration:none;">
                  #{tag}
                </a>
              ))}
            </div>
          </div>

          <!-- Author card -->
          <div class="card card-inner" style="margin-top:var(--space-8);display:flex;align-items:center;gap:var(--space-5);">
            <div style="width:60px;height:60px;border-radius:50%;overflow:hidden;border:2px solid var(--color-accent-cyan);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <img src="/images/yaji-photo.jpg" alt="Yaji Timothy Terungwa" style="width:100%;height:100%;object-fit:cover;" />
            </div>
            <div>
              <p class="font-display" style="font-weight:700;margin-bottom:var(--space-1);">Yaji Timothy Terungwa</p>
              <p class="text-sm text-secondary" style="line-height:var(--leading-relaxed);">Statistician &amp; Data Scientist. PhD Candidate in Statistics. I write about statistical theory, GIS, and data analytics.</p>
            </div>
          </div>

          <!-- Giscus Comments -->
          <div style="margin-top:var(--space-12);">
            <h2 class="font-display" style="font-size:var(--text-h3);font-weight:700;margin-bottom:var(--space-6);">
              Discussion &amp; Comments
            </h2>
            <div class="giscus-wrapper animate-in" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:var(--space-6);">
              <script src="https://giscus.app/client.js"
                      data-repo="Yajitim/yajitim.github.io"
                      data-repo-id="R_kgDOTgZ4Jw"
                      data-category="Polls"
                      data-category-id="DIC_kwDOTgZ4J84DBv8R"
                      data-mapping="pathname"
                      data-strict="0"
                      data-reactions-enabled="1"
                      data-emit-metadata="0"
                      data-input-position="bottom"
                      data-theme="dark"
                      data-lang="en"
                      crossorigin="anonymous"
                      async>
              </script>
            </div>
          </div>
        </div>

        <!-- Sidebar / Table of Contents -->
        {filteredHeadings.length > 0 && (
          <aside class="toc-sidebar-container" style="position:sticky;top:calc(var(--nav-height) + var(--space-6));">
            <div class="toc-wrapper">
              <div class="toc-title">
                <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" style="width:16px;height:16px;">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                Table of Contents
              </div>
              <nav aria-label="Table of contents">
                <ul class="toc-list">
                  {filteredHeadings.map(h => (
                    <li class={`toc-item toc-depth-${h.depth}`}>
                      <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </aside>
        )}

      </div>

      <!-- Related Posts -->
      {related.length > 0 && (
        <div style="max-width:100%;margin-top:var(--space-16);">
          <div class="section-header">
            <span class="section-label">More Reading</span>
            <h2 class="section-title">Related <span class="underline-cyan">Posts</span></h2>
          </div>
          <div class="grid-3">
            {related.map((rPost, i) => (
              <article class="card blog-card animate-in" style={`animation-delay:${i*60}ms`} id={`related-${rPost.slug}`}>
                <div class="blog-card-cover">
                  <div style={`width:100%;height:100%;background:linear-gradient(135deg,${i===0?'#1a0d2e,#2e1a4a':'#0d2e1a,#1a4a2e'});display:flex;align-items:center;justify-content:center;font-size:2rem;`}>
                    {['📦','🎨','⚡'][i]}
                  </div>
                </div>
                <div class="blog-card-body">
                  <div class="blog-card-meta">
                    <span class={`badge ${categoryColors[rPost.data.category] || 'badge-surface'}`}>{rPost.data.category}</span>
                    <span>·</span>
                    <span>{rPost.data.readingTime ?? 5} min</span>
                  </div>
                  <h3 class="blog-card-title font-display">{rPost.data.title}</h3>
                  <a href={`/blog/${rPost.slug}`} class="project-card-link">Read →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr !important;
    }
    .toc-sidebar-container {
      display: none !important;
    }
  }
</style>

<script>
  function setupArticleFeatures() {
    // Reading progress bar
    const progressBar = document.getElementById('reading-progress');
    if (progressBar) {
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? scrollTop / docHeight : 0;
        progressBar.style.transform = `scaleX(${progress})`;
        progressBar.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    // Copy link button
    const copyLinkBtn = document.getElementById('copy-link-btn');
    copyLinkBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        const prevText = copyLinkBtn.textContent;
        copyLinkBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyLinkBtn.textContent = prevText;
        }, 2000);
      });
    });

    // Enhance Code Blocks with Copy Button
    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      const header = document.createElement('div');
      header.className = 'code-block-header';

      const code = pre.querySelector('code');
      const langMatch = code?.className.match(/language-([a-z0-9_-]+)/i);
      const lang = langMatch ? langMatch[1].toUpperCase() : 'CODE';

      header.innerHTML = `
        <span class="code-lang">${lang}</span>
        <button class="code-copy-btn" type="button">Copy</button>
      `;

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);

      const copyBtn = header.querySelector('.code-copy-btn');
      copyBtn?.addEventListener('click', () => {
        const text = pre.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = 'Copy';
          }, 2000);
        });
      });
    });

    // Table of contents active heading spy
    const tocLinks = document.querySelectorAll('.toc-link');
    const headings = Array.from(document.querySelectorAll('.prose h2, .prose h3'));

    if (headings.length && tocLinks.length) {
      const onScroll = () => {
        let activeId = '';
        const scrollPosition = window.scrollY + 120;

        for (const heading of headings) {
          if ((heading as HTMLElement).offsetTop <= scrollPosition) {
            activeId = heading.id;
          }
        }

        tocLinks.forEach((link) => {
          if (link.getAttribute('data-slug') === activeId) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }

  document.addEventListener('astro:page-load', setupArticleFeatures);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupArticleFeatures);
  } else {
    setupArticleFeatures();
  }
</script>
