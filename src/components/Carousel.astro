---
export interface CarouselItem {
  src: string;
  alt: string;
  caption?: string;
  badge?: string;
}

export interface Props {
  items: CarouselItem[];
  id?: string;
  autoplay?: boolean;
  interval?: number;
}

const {
  items = [],
  id = `carousel-${Math.random().toString(36).substring(2, 9)}`,
  autoplay = true,
  interval = 4000,
} = Astro.props;
---

<div class="carousel-container" id={id} data-autoplay={autoplay ? "true" : "false"} data-interval={interval}>
  <div class="carousel-viewport">
    <div class="carousel-track">
      {items.map((item, index) => (
        <div class={`carousel-slide ${index === 0 ? "active" : ""}`} data-index={index}>
          <div class="carousel-image-wrapper">
            <img src={item.src} alt={item.alt} loading={index === 0 ? "eager" : "lazy"} />
            {item.badge && <span class="carousel-badge">{item.badge}</span>}
          </div>
          {item.caption && <p class="carousel-caption">{item.caption}</p>}
        </div>
      ))}
    </div>
  </div>

  {items.length > 1 && (
    <>
      <button class="carousel-control prev" aria-label="Previous slide" type="button">
        &#10094;
      </button>
      <button class="carousel-control next" aria-label="Next slide" type="button">
        &#10095;
      </button>
      <div class="carousel-indicators">
        {items.map((_, index) => (
          <button
            class={`carousel-dot ${index === 0 ? "active" : ""}`}
            data-index={index}
            aria-label={`Go to slide ${index + 1}`}
            type="button"
          />
        ))}
      </div>
    </>
  )}
</div>

<style>
  .carousel-container {
    position: relative;
    width: 100%;
    margin-block: var(--space-8);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .carousel-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }

  .carousel-slide {
    min-width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .carousel-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 520px;
    background: #090a0f;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .carousel-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .carousel-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: rgba(13, 13, 15, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border-glow);
    color: var(--color-accent-cyan);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .carousel-caption {
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-align: center;
    width: 100%;
    background: var(--color-surface-raised);
    border-top: 1px solid var(--color-border-subtle);
  }

  .carousel-control {
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(13, 13, 15, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all var(--transition-fast);
  }

  .carousel-control:hover {
    background: var(--color-accent-cyan-dim);
    border-color: var(--color-accent-cyan);
    color: var(--color-accent-cyan);
  }

  .carousel-control.prev { left: var(--space-3); }
  .carousel-control.next { right: var(--space-3); }

  .carousel-indicators {
    position: absolute;
    bottom: var(--space-10);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--space-2);
    z-index: 10;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0;
  }

  .carousel-dot.active {
    width: 24px;
    border-radius: var(--radius-full);
    background: var(--color-accent-cyan);
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.6);
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll('.carousel-container').forEach((container) => {
      if (container.hasAttribute('data-initialized')) return;
      container.setAttribute('data-initialized', 'true');

      const track = container.querySelector('.carousel-track') as HTMLElement;
      const slides = container.querySelectorAll('.carousel-slide');
      const dots = container.querySelectorAll('.carousel-dot');
      const prevBtn = container.querySelector('.carousel-control.prev');
      const nextBtn = container.querySelector('.carousel-control.next');

      if (!track || slides.length <= 1) return;

      let currentIndex = 0;
      const total = slides.length;
      let timer: any = null;
      const autoplay = container.getAttribute('data-autoplay') === 'true';
      const interval = parseInt(container.getAttribute('data-interval') || '4000', 10);

      function updateSlide(index: number) {
        currentIndex = (index + total) % total;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        dots.forEach((d, i) => {
          d.classList.toggle('active', i === currentIndex);
        });
      }

      function startAutoplay() {
        if (!autoplay) return;
        stopAutoplay();
        timer = setInterval(() => {
          updateSlide(currentIndex + 1);
        }, interval);
      }

      function stopAutoplay() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      prevBtn?.addEventListener('click', () => {
        updateSlide(currentIndex - 1);
        startAutoplay();
      });

      nextBtn?.addEventListener('click', () => {
        updateSlide(currentIndex + 1);
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          updateSlide(idx);
          startAutoplay();
        });
      });

      container.addEventListener('mouseenter', stopAutoplay);
      container.addEventListener('mouseleave', startAutoplay);

      startAutoplay();
    });
  }

  document.addEventListener('astro:page-load', initCarousels);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousels);
  } else {
    initCarousels();
  }
</script>
